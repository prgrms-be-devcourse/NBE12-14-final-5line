MYSQL_DATABASE=outpick
MYSQL_USER=outpick
MYSQL_PORT=3306
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 공공데이터포털 일반 인증키(Decoding). 프런트엔드에 넣지 않습니다.
TOUR_API_KEY=

# 운영 정보 정기 비교. 기본은 꺼져 있으며 배포 백엔드 한 대에서 활성화합니다.
OUTPICK_TOUR_OPERATING_ENABLED=false
OUTPICK_TOUR_OPERATING_CRON="0 30 10 * * *"
OUTPICK_TOUR_OPERATING_MAX_PLACES=500
